# Copia este archivo como .env y completa tus datos (setup.bat lo copia solo).
# .env NUNCA se sube a GitHub: tiene tus claves.

# --- Spotify (opcional) -------------------------------------------------------
# Client ID de una app de https://developer.spotify.com/dashboard con la
# Redirect URI exactamente: http://127.0.0.1:8888/callback
# Cada persona inicia sesion con su propia cuenta la primera vez que abre la app.
# Sin esto, la app funciona solo con el microfono.
SPOTIPY_CLIENT_ID=
# SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- LLM para detectar instrumentos: gemini | groq | ollama -------------------
#   gemini -> key gratis en https://aistudio.google.com/apikey
#   groq   -> key gratis en https://console.groq.com/keys
#   ollama -> sin key, requiere "ollama serve" en local
# Sin key se muestra una banda por defecto (voz, guitarra, bajo, bateria).
LLM_PROVIDER=gemini
LLM_API_KEY=
# Opcional: cambiar el modelo por defecto del proveedor
# LLM_MODEL=
# Opcional: otra URL compatible con OpenAI (ej. Ollama en otro PC de la casa)
# LLM_BASE_URL=http://192.168.1.50:11434/v1/chat/completions
